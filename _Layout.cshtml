<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Feedback Management</title>

    <style>
        body {
            font-family: Arial;
            margin: 0;
            background-color: #f4f6f8;
        }

        header {
            background-color: #222;
            color: white;
            padding: 20px;
        }

        nav a {
            color: white;
            margin-right: 20px;
            text-decoration: none;
        }

        .container {
            width: 80%;
            margin: 30px auto;
            background: white;
            padding: 30px;
            border-radius: 8px;
        }

        footer {
            text-align: center;
            padding: 20px;
            background-color: #222;
            color: white;
            margin-top: 30px;
        }

        .validation {
            color: red;
        }
    </style>
</head>

<body>

    <header>
        <h1>Feedback Management System</h1>

        <nav>
            @Html.ActionLink("Home", "Index", "Feedback")
            @Html.ActionLink("Give Feedback", "Create", "Feedback")
        </nav>
    </header>

    <div class="container">
        @RenderBody()
    </div>

    <footer>
        © 2026 Feedback Management System
    </footer>

    @RenderSection("Scripts", required: false)

</body>
</html>