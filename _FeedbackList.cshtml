@model FeedbackManagement.Models.Feedback

<div style="border:1px solid #ddd; padding:15px; margin-bottom:15px; border-radius:8px;">

    <h3>@Model.Name</h3>

    <p>
        <b>Email:</b> @Model.Email
    </p>

    <p>
        <b>Rating:</b> @Model.Rating / 5
    </p>

    <p>
        <b>Feedback:</b> @Model.Message
    </p>

</div>
